# Copie para ".env". Tudo aqui é opcional para rodar localmente.

# Porta e endereço público (usado nos links enviados ao cliente)
PORT=8000
BASE_URL=http://localhost:8000

# Onde ficam o banco (SQLite) e as imagens enviadas. Em produção, aponte para um volume persistente.
# DATA_DIR=/dados

# Chave de assinatura dos cookies. Se vazia, é gerada uma vez e guardada em data/secret.key.
# SECRET_KEY=

# Emissão de NF-e pela Focus NFe (https://focusnfe.com.br). Sem token, a loja usa o emissor SIMULADO.
# FOCUS_NFE_TOKEN=
# FOCUS_NFE_AMBIENTE=homologacao   # homologacao | producao

# E-mails transacionais (opcional). Sem SMTP, as mensagens ficam em Painel → Mensagens para copiar.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=loja@seudominio.com.br

# Webhook de confirmação de pagamento (para ligar um PSP depois). Qualquer texto longo e secreto.
# WEBHOOK_TOKEN=

# Assistente opcional (descrição de produtos e respostas de pós-venda) com a API da Claude.
# ANTHROPIC_API_KEY=
# MODELO_ASSISTENTE=claude-sonnet-5-5

# Fuso horário da loja
FUSO_HORARIO=America/Sao_Paulo
